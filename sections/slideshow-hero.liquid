{%- liquid
  assign theme_rtl = false
  if settings.enable_rtl and settings.langauges_rtl == blank
    assign theme_rtl = true
  endif

  if settings.enable_rtl and settings.langauges_rtl != blank
    assign rtl_languages = settings.langauges_rtl | split: ','
    for language in rtl_languages
      if language == request.locale.iso_code
        assign theme_rtl = true
      endif
    endfor
  endif

  if section.settings.fullscreen == true
    assign fullscreen = 'is-fullscreen'
  endif

  assign container = ''
  if section.settings.container == 'container'
    assign container = 'container'
  elsif section.settings.container == 'container-fluid'
    assign container = 'container-fluid'
  elsif section.settings.container == 'container-full'
    assign container = 'container-full'
  else
    assign container = 'container-fluid px-0'
  endif

  assign video_slide = false
  if section.settings.slide_height == 'adapt_image' and section.blocks.first.settings.image != blank and section.blocks.first.settings.video != blank
    assign video_slide = true
  endif
-%}

{{ 'slideshow-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
    {%- if section.settings.slide_height == 'adapt_image' and section.blocks.first.settings.image != blank -%}

      {%- unless section.blocks.first.settings.image2 != blank -%}
      @media screen and (max-width: 767px) {
        {% if video_slide %}
        #slideshow-hero__{{ section.id }} .slideshow-hero__banner--adapt_image.media {
        	height: 39rem;
        }
        {% else %}
        #slideshow-hero__{{ section.id }} .slideshow-hero__banner--adapt_image.media {
        	padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image.aspect_ratio | times: 100 }}%;
        }
        {% endif %}
      }
      {%- endunless -%}

      @media screen and (min-width: 768px) {
        #slideshow-hero__{{ section.id }} .slideshow-hero__banner--adapt_image.media{
        	padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image.aspect_ratio | times: 100 }}%;
        }
      }
      #slideshow-hero__{{ section.id }} .slideshow-hero__banner--adapt_image.placeholder {
      	height: auto;
      }
    {%- endif -%}

    {%- if section.settings.slide_height == 'adapt_image' and section.blocks.first.settings.image2 != blank -%}
    @media screen and (max-width: 767px) {
      {% if video_slide %}
      #slideshow-hero__{{ section.id }} .slideshow-hero__banner--adapt_image.media {
      	height: 39rem;
      }
      {% else %}
      #slideshow-hero__{{ section.id }} .slideshow-hero__banner--adapt_image.media {
      	padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image2.aspect_ratio | times: 100 }}%;
      }
      {% endif %}
    }
    {%- endif -%}
    #slideshow-hero__{{ section.id }} .slideshow-hero__content {
    	background-color: transparent;
    }

    {%- if section.settings.content_on_container -%}
    @media only screen and (max-width: 767px){
      #slideshow-hero__{{ section.id }} .slideshow-hero__content {
        position: absolute;
        top: 0;
        width: 100%;
        height: 100%;
        left: 0;
      }
     #slideshow-hero__{{ section.id }} .slide-hero__slider--items__inner {
      	padding: 1.5rem;
      }
    }
    {%- endif -%}

    .placeholder__overlay::before {
        position: absolute;
        content: "";
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        background-color: rgba(0,0,0,0.3);
    }

    {%- if section.settings.show_overlay -%}
    .slideshow-hero__content::before {
        position: absolute;
        content: "";
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
    	opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
        background-color: rgba(0,0,0,1);
    }
    {%- endif -%}

    .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
        padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
      }

      @media screen and (min-width: 750px) {
        .section-{{ section.id }}-padding {
          padding-top: {{ section.settings.padding_top }}px;
          padding-bottom: {{ section.settings.padding_bottom }}px;
        }
      }
    .slideshow-hero__media > video {
        object-fit: cover;
        object-position: center center;
    }
    @media only screen and (min-width: 750px){
      .slide-hero__slider--section.section-{{ section.id }}-padding{
        --pagination-color:
          {{  section.settings.pagination_background.red }},
          {{  section.settings.pagination_background.green }},
          {{  section.settings.pagination_background.blue }};
        --pagination-active-color:
          {{ section.settings.pagination_active_background.red }},
          {{ section.settings.pagination_active_background.green }},
          {{ section.settings.pagination_active_background.blue }};
      }
    }
    @media only screen and (max-width: 749px){
      .slide-hero__slider--section.section-{{ section.id }}-padding{
        --pagination-color:
          {{  section.settings.mobile_pagination_background.red }},
          {{  section.settings.mobile_pagination_background.green }},
          {{  section.settings.mobile_pagination_background.blue }};
        --pagination-active-color:
          {{ section.settings.mobile_pagination_active_background.red }},
          {{ section.settings.mobile_pagination_active_background.green }},
          {{ section.settings.mobile_pagination_active_background.blue }};
      }
    }
    {% if section.settings.slide_height == 'adapt_image' and section.blocks.first.settings.image == blank and section.blocks.first.settings.video != blank %}
     @media screen and (max-width: 749px) {
      .slideshow-hero__banner--adapt_image.media {
        height: 39rem;
      }
    }

  @media screen and (min-width: 750px) and (max-width: 991px) {
   .slideshow-hero__banner--adapt_image.media {
        height: 70rem;
      }
  }

  @media screen and (min-width: 992px) {
     .slideshow-hero__banner--adapt_image.media {
        height: 80rem;
      }
  }
    {% endif %}
{%- endstyle -%}
{% if section.settings.snow_fall %}
  {{ 'snow-fall.css' | asset_url | stylesheet_tag }}
{% endif %}
{%- if theme_rtl -%}
  {{ 'slideshow-rtl.css' | asset_url | stylesheet_tag }}
{%- endif -%}

<div
  class="slide-hero__slider--section section-{{ section.id }}-padding"
  data-section-id="{{ section.id }}"
  data-section-type="slideShow"
  id="slideshow-hero__{{ section.id }}"
  data-slide-autoplay="{{ section.settings.auto_rotate }}"
  data-autoplay-duration="{{ section.settings.change_slides_speed }}000"
  data-slide-loop="{{ section.settings.enable_loop }}"
>
  <div class="slide-hero__slider--inner slide-hero__slider--activation swiper">
    <div class="slide-hero__slider--wrapper swiper-wrapper">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'slide' -%}
            {%- liquid
              assign text_align = ''
              case block.settings.content_alignment
                when 'center'
                  assign text_align = 'text-center'
                when 'start'
                  assign text_align = 'text-left'
                else
                  assign text_align = 'text-right'
              endcase
            -%}

            <div class="{{ fullscreen }} swiper-slide" {{ block.shopify_attributes }}>
              {% if block.settings.enble_entire_link and block.settings.button_link %}
                <a
                  {% if block.settings.button_link %}
                    href="{{ block.settings.button_link }}"
                  {% else %}
                    role="link"
                  {% endif %}
                  class="d-block"
                >
              {%- endif %}
              <div class="slideshow-hero__media {% if section.settings.snow_fall %}snow--fall{% endif %} slideshow-hero__banner--{{ section.settings.slide_height }} {% if video_slide %} video__slider--height{% endif %} media {% if block.settings.image == blank and block.settings.video == blank %} placeholder  {% if block.settings.image == blank  and block.settings.video == blank %} placeholder__overlay{% endif %}{% endif %} {% if block.settings.image2 != blank %} d-sm-none {% endif %}">
                {%- if block.settings.video -%}
                  {{ block.settings.video | video_tag: autoplay: true, loop: true, controls: false, muted: true }}
                {%- elsif block.settings.image -%}
                  <img
                    srcset="
                      {%- if block.settings.image.width >= 375 -%}{{ block.settings.image | image_url: width: 375 }} 375w,{%- endif -%}
                      {%- if block.settings.image.width >= 550 -%}{{ block.settings.image | image_url: width: 550 }} 550w,{%- endif -%}
                      {%- if block.settings.image.width >= 750 -%}{{ block.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
                      {%- if block.settings.image.width >= 1100 -%}{{ block.settings.image | image_url: width: 1100 }} 1100w,{%- endif -%}
                      {%- if block.settings.image.width >= 1500 -%}{{ block.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
                      {%- if block.settings.image.width >= 1780 -%}{{ block.settings.image | image_url: width: 1780 }} 1780w,{%- endif -%}
                      {%- if block.settings.image.width >= 2000 -%}{{ block.settings.image | image_url: width: 2000 }} 2000w,{%- endif -%}
                      {%- if block.settings.image.width >= 3000 -%}{{ block.settings.image | image_url: width: 3000 }} 3000w,{%- endif -%}
                      {%- if block.settings.image.width >= 3840 -%}{{ block.settings.image | image_url: width: 3840 }} 3840w,{%- endif -%}
                      {{ block.settings.image | image_url }} {{ block.settings.image.width }}w
                    "
                    sizes="100vw"
                    src="{{ block.settings.image | image_url: width: 1500 }}"
                    loading="lazy"
                    alt="{{ block.settings.image.alt | escape }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round }}"
                  >
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>

              {%- if block.settings.image2 != blank -%}
                <div class="slideshow-hero__media {% if section.settings.snow_fall %}snow--fall{% endif %} slideshow-hero__banner--{{ section.settings.slide_height }} media d-sm-only-visible">
                  <img
                    srcset="
                      {%- if block.settings.image2.width >= 375 -%}{{ block.settings.image2 | image_url: width: 375 }} 375w,{%- endif -%}
                      {%- if block.settings.image2.width >= 550 -%}{{ block.settings.image2 | image_url: width: 550 }} 550w,{%- endif -%}
                      {%- if block.settings.image2.width >= 750 -%}{{ block.settings.image2 | image_url: width: 750 }} 750w,{%- endif -%}
                      {%- if block.settings.image2.width >= 1100 -%}{{ block.settings.image2 | image_url: width: 1100 }} 1100w,{%- endif -%}
                      {%- if block.settings.image2.width >= 1500 -%}{{ block.settings.image2 | image_url: width: 1500 }} 1500w,{%- endif -%}
                      {{ block.settings.image2 | image_url }} {{ block.settings.image2.width }}w
                    "
                    sizes="100vw"
                    src="{{ block.settings.image2 | image_url: width: 1500 }}"
                    loading="lazy"
                    alt="{{ block.settings.image2.alt | escape }}"
                    width="{{ block.settings.image2.width }}"
                    height="{{ block.settings.image2.width | divided_by: block.settings.image2.aspect_ratio | round }}"
                  >
                </div>
              {%- endif -%}

              <div class="slideshow-hero__content color-{{ block.settings.color_scheme }} {% if block.settings.color_scheme_enable %} d-sm-none {% endif %}">
                <div class="{{ container }} h-100">
                  <div class="slide-hero__slider--items__inner h-100">
                    {% comment %} PRODUCT 1 {% endcomment %}
                    {%- if block.settings.product_image_1 != blank -%}
                      <div class="product-image-wrap-1a">
                        <img
                          class="product-image-1a"
                          srcset="
                            {%- if block.settings.product_image_1.width >= 250 -%}{{ block.settings.product_image_1 | image_url: width: 250 }} 250w,{%- endif -%}
                            {{ block.settings.product_image_1 | image_url }} {{ block.settings.product_image_1.width }}w
                          "
                          sizes="100vw"
                          src="{{ block.settings.product_image_1 | image_url: width: 250 }}"
                          loading="lazy"
                          alt="{{ block.settings.product_image_1.alt | escape }}"
                          width="250"
                          height="250"
                        >
                      </div>
                      <div class="product-image-wrap-1b">
                        <img
                          class="product-image-1b"
                          srcset="
                            {%- if block.settings.product_image_1.width >= 150 -%}{{ block.settings.product_image_1 | image_url: width: 150 }} 150w,{%- endif -%}
                            {{ block.settings.product_image_1 | image_url }} {{ block.settings.product_image_1.width }}w
                          "
                          sizes="100vw"
                          src="{{ block.settings.product_image_1 | image_url: width: 150 }}"
                          loading="lazy"
                          alt="{{ block.settings.product_image_1.alt | escape }}"
                          width="150"
                          height="150"
                        >
                      </div>
                      <div class="product-image-wrap-1c">
                        <img
                          class="product-image-1c"
                          srcset="
                            {%- if block.settings.product_image_1.width >= 100 -%}{{ block.settings.product_image_1 | image_url: width: 100 }} 100w,{%- endif -%}
                            {{ block.settings.product_image_1 | image_url }} {{ block.settings.product_image_1.width }}w
                          "
                          sizes="100vw"
                          src="{{ block.settings.product_image_1 | image_url: width: 100 }}"
                          loading="lazy"
                          alt="{{ block.settings.product_image_1.alt | escape }}"
                          width="100"
                          height="100"
                        >
                      </div>
                    {%- endif -%}
                    {% comment %} PRODUCT 2 {% endcomment %}
                    {%- if block.settings.product_image_2 != blank -%}
                      <div class="product-image-wrap-2a">
                        <img
                          class="product-image-2a"
                          srcset="
                            {%- if block.settings.product_image_2.width >= 280 -%}{{ block.settings.product_image_2 | image_url: width: 280 }} 280w,{%- endif -%}
                            {{ block.settings.product_image_2 | image_url }} {{ block.settings.product_image_2.width }}w
                          "
                          sizes="100vw"
                          src="{{ block.settings.product_image_2 | image_url: width: 280 }}"
                          loading="lazy"
                          alt="{{ block.settings.product_image_2.alt | escape }}"
                          width="280"
                          height="280"
                        >
                      </div>
                    {%- endif -%}
                    {%- if block.settings.product_image_2 != blank -%}
                      <div class="product-image-wrap-2b">
                        <img
                          class="product-image-2b"
                          srcset="
                            {%- if block.settings.product_image_2.width >= 150 -%}{{ block.settings.product_image_2 | image_url: width: 150 }} 150w,{%- endif -%}
                            {{ block.settings.product_image_2 | image_url }} {{ block.settings.product_image_2.width }}w
                          "
                          sizes="100vw"
                          src="{{ block.settings.product_image_2 | image_url: width: 150 }}"
                          loading="lazy"
                          alt="{{ block.settings.product_image_2.alt | escape }}"
                          width="150"
                          height="150"
                        >
                      </div>
                    {%- endif -%}
                    {%- if block.settings.product_image_2 != blank -%}
                      <div class="product-image-wrap-2c">
                        <img
                          class="product-image-2c"
                          srcset="
                            {%- if block.settings.product_image_2.width >= 200 -%}{{ block.settings.product_image_2 | image_url: width: 200 }} 200w,{%- endif -%}
                            {{ block.settings.product_image_2 | image_url }} {{ block.settings.product_image_2.width }}w
                          "
                          sizes="100vw"
                          src="{{ block.settings.product_image_2 | image_url: width: 200 }}"
                          loading="lazy"
                          alt="{{ block.settings.product_image_2.alt | escape }}"
                          width="200"
                          height="200"
                        >
                      </div>
                    {%- endif -%}
                    {% comment %} PRODUCT 3 {% endcomment %}
                    {%- if block.settings.product_image_3 != blank -%}
                      <div class="product-image-wrap-3a">
                        <img
                          class="product-image-3a"
                          srcset="
                            {%- if block.settings.product_image_3.width >= 300 -%}{{ block.settings.product_image_3 | image_url: width: 300 }} 300w,{%- endif -%}
                            {{ block.settings.product_image_3 | image_url }} {{ block.settings.product_image_3.width }}w
                          "
                          sizes="100vw"
                          src="{{ block.settings.product_image_3 | image_url: width: 300 }}"
                          loading="lazy"
                          alt="{{ block.settings.product_image_3.alt | escape }}"
                          width="300"
                          height="300"
                        >
                      </div>
                    {%- endif -%}
                    {%- if block.settings.product_image_3 != blank -%}
                      <div class="product-image-wrap-3b">
                        <img
                          class="product-image-3b"
                          srcset="
                            {%- if block.settings.product_image_3.width >= 150 -%}{{ block.settings.product_image_3 | image_url: width: 150 }} 150w,{%- endif -%}
                            {{ block.settings.product_image_3 | image_url }} {{ block.settings.product_image_3.width }}w
                          "
                          sizes="100vw"
                          src="{{ block.settings.product_image_3 | image_url: width: 150 }}"
                          loading="lazy"
                          alt="{{ block.settings.product_image_3.alt | escape }}"
                          width="150"
                          height="150"
                        >
                      </div>
                    {%- endif -%}
                    {%- if block.settings.product_image_3 != blank -%}
                      <div class="product-image-wrap-3c">
                        <img
                          class="product-image-3c"
                          srcset="
                            {%- if block.settings.product_image_3.width >= 80 -%}{{ block.settings.product_image_3 | image_url: width: 80 }} 80w,{%- endif -%}
                            {{ block.settings.product_image_3 | image_url }} {{ block.settings.product_image_3.width }}w
                          "
                          sizes="100vw"
                          src="{{ block.settings.product_image_3 | image_url: width: 80 }}"
                          loading="lazy"
                          alt="{{ block.settings.product_image_3.alt | escape }}"
                          width="80"
                          height="80"
                        >
                      </div>
                    {%- endif -%}

                    <div class="d-flex align-items-center h-100 justify-content-{{ block.settings.content_alignment }} {{ text_align }}">
                      <div class="col-md-12">
                        <div class="slider-hero__content slider-hero__content--padding__left">
                          {%- if block.settings.subheading != blank -%}
                            <span class="swiper-no-swiping slider-hero__content--subtitle {{ block.settings.subheading_color }}">
                              {{- block.settings.subheading -}}
                            </span>
                          {%- endif -%}

                          {%- if block.settings.heading != blank -%}
                            <h2 class="swiper-no-swiping slider-hero__content--maintitle {{ block.settings.heading_size }} mb-0 gradient--text">
                              {{- block.settings.heading -}}
                            </h2>
                          {%- endif -%}

                          {%- if block.settings.text != blank -%}
                            <p class="swiper-no-swiping slider-hero__content--desc">
                              {{ block.settings.text | replace: 'p>', 'span>' }}
                            </p>
                          {%- endif -%}
                          {% liquid
                            if block.settings.button_type == 'primary'
                              assign button_class = 'button--primary'
                            else
                              assign button_class = 'button--secondary'
                            endif
                          %}

                          {%- if block.settings.button_label != blank -%}
                            {% unless block.settings.enble_entire_link %}
                              <a
                                {% if block.settings.button_link %}
                                  href="{{ block.settings.button_link }}"
                                {% else %}
                                  role="link" aria-disabled="true"
                                {% endif %}
                                class="button-wrapper"
                              >
                            {% endunless %}
                            {% if block.settings.enble_entire_link %}
                              <button class="button-alt">
                            {%- endif %}

                            <span class="test button button--{{ block.settings.button_size }} {{ button_class }} button--with-icon">
                              {{- block.settings.button_label | escape -}}
                              {% if block.settings.button_icon %}
                                <span class="button--icon button--icon-right"> {% render 'icon-arrow-right' %} </span>
                              {% endif %}
                            </span>

                            {% if block.settings.enble_entire_link %} </button> {% endif %}
                            {% unless block.settings.enble_entire_link %}
                              </a>
                            {% endunless %}
                          {%- endif -%}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              {% if block.settings.color_scheme_enable %}
                <div class="slideshow-hero__content color-{{ block.settings.color_scheme_2 }} d-sm-only-visible">
                  <div class="slide-hero__content_width h-100">
                    <div class="slide-hero__slider--items__inner h-100">
                      <div class="d-flex align-items-center h-100 justify-content-{{ block.settings.content_alignment }} {{ text_align }} ">
                        <div class="col-md-12">
                          <div class="slider-hero__content slider-hero__content--padding__left">
                            {%- if block.settings.subheading != blank -%}
                              <span class="swiper-no-swiping slider-hero__content--subtitle {{ block.settings.subheading_color }}">
                                {{- block.settings.subheading -}}
                              </span>
                            {%- endif -%}

                            {%- if block.settings.heading != blank -%}
                              <h2 class="swiper-no-swiping slider-hero__content--maintitle {{ block.settings.heading_size }} mb-0">
                                {{- block.settings.heading | replace: 'p>', 'span>' -}}
                              </h2>
                            {%- endif -%}

                            {%- if block.settings.text != blank -%}
                              <p class="swiper-no-swiping slider-hero__content--desc">
                                {{- block.settings.text | replace: 'p>', 'span>' -}}
                              </p>
                            {%- endif -%}
                            {% liquid
                              if block.settings.button_type == 'primary'
                                assign button_class = ''
                              else
                                assign button_class = 'button--secondary'
                              endif
                            %}
                            {%- if block.settings.button_label != blank -%}
                              <a
                                {% if block.settings.button_link != blank %}
                                  href="{{ block.settings.button_link }}"
                                {% endif %}
                                class="button button--{{ block.settings.button_size }} {{ button_class }} button--with-icon"
                                {% if block.settings.button_link == blank %}
                                  aria-disabled="true"
                                {% endif %}
                              >
                                {{ block.settings.button_label | escape }}
                                {% if block.settings.button_icon %}
                                  <span class="button--icon button--icon-right"> {% render 'icon-arrow-right' %} </span>
                                {% endif %}
                              </a>
                            {%- endif -%}
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              {%- endif -%}
              {% if block.settings.enble_entire_link and block.settings.button_link %} </a>{% endif %}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {% comment %}
      Pagination & navigation stuff here
    {% endcomment %}
    {%- if section.settings.show_pagination -%}
      <div class="slider-hero__pagination swiper-pagination color-{{ section.settings.color_scheme_pagination }}"></div>
    {%- endif -%}

    {%- if section.settings.show_navigation -%}
      <div class="swiper-button-next slideshow-hero--nav-button">
        {% render 'icon-arrow-right' %}
      </div>
      <div class="swiper-button-prev slideshow-hero--nav-button">
        {% render 'icon-arrow-left' %}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Slideshow Hero",
  "settings": [
    {
      "type": "checkbox",
      "id": "snow_fall",
      "label": "Enable snow fall",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "fullscreen",
      "label": "Fullscreen?",
      "default": true
    },
    {
      "type": "select",
      "id": "container",
      "label": "Page width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Boxed"
        },
        {
          "value": "container-fluid",
          "label": "Full width"
        },
        {
          "value": "container-full",
          "label": "Full screen"
        }
      ]
    },
    {
      "type": "select",
      "id": "slide_height",
