<link rel="stylesheet" href="{{ 'component-rte.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'section-rich-text.css' | asset_url }}" media="print" onload="this.media='all'">

<noscript>{{ 'component-rte.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .rich-text__block-background-{{ section.id }} {
    {%- if section.settings.bg_color -%}
      background-color: {{ section.settings.bg_color }};
    {%- elsif section.settings.bg_image -%}
      background-image: url("{{ section.settings.bg_image | image_url: width: 1500 }}");
      background-size: cover;
      background-position: center;
    {%- endif -%}
  }

  .rich-text__heading-{{ section.id }} strong {
    {%- for block in section.blocks -%}
      -webkit-text-fill-color: {{ block.settings.heading_bold_color }};
      color: {{ block.settings.heading_outline_color }};
      -webkit-text-stroke-width: 1px;
      -webkit-text-stroke-color: {{ block.settings.heading_outline_color }};
      text-shadow: -2px 2px 1px {{ block.settings.heading_outline_color }},
                   -2px 2px 1px {{ block.settings.heading_outline_color }},
                   -2px 2px 1px {{ block.settings.heading_outline_color }},
                   -2px 2px 1px {{ block.settings.heading_outline_color }};
    {%- endfor -%}
  }
  .rich-text__heading-{{ section.id }}{
    {%- for block in section.blocks -%}
      text-transform:{{ block.settings.heading_casing }};
    {%- endfor -%}
  }
  {%- if section.settings.stylize_cta -%}
  .rich-text__blocks-{{ section.id }}{
    box-shadow: -10px 10px 0px {{ section.settings.shadow_color }};
  }
  {%- endif -%}
{%- endstyle -%}

<div class="rich-text rich-text-wrap container-fluid section--top-space-{{ section.id }} color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  {%- if section.settings.section_bg_image -%}
    <div class="rich-text-section-bg-image">
      <img
        srcset="
          {%- if section.settings.section_bg_image.width >= 375 -%}{{ section.settings.section_bg_image | image_url: width: 375 }} 375w,{%- endif -%}
          {%- if section.settings.section_bg_image.width >= 550 -%}{{ section.settings.section_bg_image | image_url: width: 550 }} 550w,{%- endif -%}
          {%- if section.settings.section_bg_image.width >= 750 -%}{{ section.settings.section_bg_image | image_url: width: 750 }} 750w,{%- endif -%}
          {%- if section.settings.section_bg_image.width >= 1100 -%}{{ section.settings.section_bg_image | image_url: width: 1100 }} 1100w,{%- endif -%}
          {%- if section.settings.section_bg_image.width >= 1500 -%}{{ section.settings.section_bg_image | image_url: width: 1500 }} 1500w,{%- endif -%}
          {%- if section.settings.section_bg_image.width >= 1780 -%}{{ section.settings.section_bg_image | image_url: width: 1780 }} 1780w,{%- endif -%}
          {%- if section.settings.section_bg_image.width >= 2000 -%}{{ section.settings.section_bg_image | image_url: width: 2000 }} 2000w,{%- endif -%}
          {%- if section.settings.section_bg_image.width >= 3000 -%}{{ section.settings.section_bg_image | image_url: width: 3000 }} 3000w,{%- endif -%}
          {%- if section.settings.section_bg_image.width >= 3840 -%}{{ section.settings.section_bg_image | image_url: width: 3840 }} 3840w,{%- endif -%}
          {{ section.settings.section_bg_image | image_url }} {{ section.settings.section_bg_image.width }}w
        "
        sizes="100vw"
        src="{{ section.settings.section_bg_image | image_url: width: 1500 }}"
        loading="lazy"
        alt="{{ section.settings.section_bg_image.alt | escape }}"
        width="{{ section.settings.section_bg_image.width }}"
        height="{{ section.settings.section_bg_image.width | divided_by: section.settings.section_bg_image.aspect_ratio | round }}"
      >
    </div>
  {%- endif -%}
  <div class="rich-text__blocks rich-text__blocks-{{ section.id }} page-width text-{{ section.settings.alignment }} mobile-text-{{ section.settings.mobile_alignment }} rich-text__block-background-{{ section.id }}">
    {%- if section.settings.bg_image -%}
      <div class="rich-text__bg-image">
        <img
          srcset="
            {%- if section.settings.bg_image.width >= 375 -%}{{ section.settings.bg_image | image_url: width: 375 }} 375w,{%- endif -%}
            {%- if section.settings.bg_image.width >= 550 -%}{{ section.settings.bg_image | image_url: width: 550 }} 550w,{%- endif -%}
            {%- if section.settings.bg_image.width >= 750 -%}{{ section.settings.bg_image | image_url: width: 750 }} 750w,{%- endif -%}
            {%- if section.settings.bg_image.width >= 1100 -%}{{ section.settings.bg_image | image_url: width: 1100 }} 1100w,{%- endif -%}
            {%- if section.settings.bg_image.width >= 1500 -%}{{ section.settings.bg_image | image_url: width: 1500 }} 1500w,{%- endif -%}
            {{ section.settings.bg_image | image_url }} {{ section.settings.bg_image.width }}w
          "
          sizes="100vw"
          src="{{ section.settings.bg_image | image_url: width: 1500 }}"
          loading="lazy"
          alt="{{ section.settings.bg_image.alt | escape }}"
          width="100%"
          height="100%"
        >
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          <h2
            class="rich-text__heading rich-text__heading-{{ section.id }} {{ block.settings.heading_size }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.heading | replace: 'p>', 'span>' }}
          </h2>
        {%- when 'text' -%}
          <div
            class="rich-text__text rte rich-text__{{ block.settings.text_size }} richt_text--{{ block.settings.text_color }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.text }}
          </div>
        {%- when 'button' -%}
          {% liquid
            if block.settings.button_style == 'primary'
              assign button_class = ''
            else
              assign button_class = 'button--secondary'
            endif
          %}

          <a
            {% if block.settings.button_link == blank %}
              aria-disabled="true"
            {% else %}
              href="{{ block.settings.button_link }}"
            {% endif %}
            class="button-wrapper"
            {{ block.shopify_attributes }}
          >
            <span class="button button--{{ block.settings.button_size }} {{ button_class }}">
              {{ block.settings.button_label | escape }}
            </span>
          </a>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.rich-text.name",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Desktop content alignment"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Mobile content alignment"
    },

    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image",
      "info": "This gets applied on the inner most content box."
    },
    {
      "type": "image_picker",
      "id": "section_bg_image",
      "label": "Section background image",
      "info": "This goes on the section as a whole."
    },
    {
      "type": "checkbox",
      "id": "stylize_cta",
      "label": "Stylize CTA",
      "info": "This adds a hard dropshadow effect."
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Shadow Color",
      "default": "#1F5422",
      "info": "This sets the color of the shadow when stylize CTA is enabled."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "paragraph",
      "content": "Desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 50
    },
    {
      "type": "paragraph",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.rich-text.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "heading",
          "default": "<p>Talk about your brand</p>",
          "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h3",
              "label": "Small"
            },
            {
              "value": "h2",
              "label": "Medium"
            },
            {
              "value": "h1",
              "label": "Large"
            },
            {
              "value": "h0",
              "label": "Extra large"
            }
          ],
          "default": "h2",
          "label": "Heading size"
        },
        {
          "type": "select",
          "id": "heading_casing",
          "options": [
            {
              "value": "uppercase",
              "label": "Uppercase"
            },
            {
              "value": "lowercase",
              "label": "Lowercase"
            },
            {
              "value": "capitalize",
              "label": "Capitals"
            },
            {
              "value": "none",
              "label": "None"
            }
          ],
          "default": "uppercase",
          "label": "Heading Casing"
        },
        {
          "type": "header",
          "content": "Header Bold Color Settings",
          "info": "There's unique styles that apply to bold headings, set the colors below."
        },
        {
          "type": "color",
          "id": "heading_bold_color",
          "label": "Heading Bold Color"
        },
        {
          "type": "color",
          "id": "heading_outline_color",
          "label": "Heading Outline Color"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.rich-text.blocks.text.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.</p>",
          "label": "t:sections.rich-text.blocks.text.settings.text.label"
        },
        {
          "type": "select",
          "id": "text_size",
          "options": [
            {
              "value": "large",
              "label": "Large"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "small",
              "label": "Small"
            }
          ],
          "default": "small",
          "label": "Text size"
        },
        {
          "type": "select",
          "id": "text_color",
          "options": [
            {
              "value": "body",
              "label": "Body"
            },
            {
              "value": "heading",
              "label": "Heading"
            }
          ],
          "default": "body",
          "label": "Text color"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.rich-text.blocks.button.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "default": "Button label",
          "label": "t:sections.rich-text.blocks.button.settings.button_label.label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.rich-text.blocks.button.settings.button_link.label"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "default": "primary",
          "options": [
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "primary",
              "label": "Primary"
            }
          ]
        },
        {
          "type": "select",
          "id": "button_size",
          "label": "Button size",
          "default": "large",
          "options": [
            {
              "value": "large",
              "label": "Large"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "small",
              "label": "Small"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.rich-text.presets.name",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
